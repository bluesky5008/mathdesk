# 테스트 운영(Phase A′) 이미지: 웹 정적 빌드를 API가 단일 오리진으로 서빙한다.
FROM node:24-alpine AS web
WORKDIR /web
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci
COPY apps/web/ ./
RUN npm run build

FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /usr/local/bin/uv

# 리포트 카드의 한글 글리프. Chromium이 이 글꼴로 카드를 그린다
RUN apt-get update && apt-get install -y --no-install-recommends fonts-nanum \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY apps/api/pyproject.toml apps/api/uv.lock apps/api/alembic.ini ./
COPY apps/api/src ./src
COPY apps/api/migrations ./migrations
RUN uv sync --frozen --no-dev

ENV PATH="/app/.venv/bin:$PATH"

# 헤드리스 Chromium([ADR-011]). 스크린샷에는 headless shell만 있으면 되므로
# --only-shell로 전체 Chromium과 ffmpeg를 뺀다(이미지 1.03GB → 약 0.5GB)
RUN playwright install --with-deps --only-shell chromium && rm -rf /var/lib/apt/lists/*

COPY --from=web /web/dist ./web
# 카드 렌더러가 읽는 토큰 파일. 웹 정적 빌드와 경로가 겹치지 않게 따로 둔다
COPY apps/web/src/styles/tokens.css ./tokens.css

ENV MATHDESK_WEB_DIST=/app/web \
    MATHDESK_TOKENS_CSS=/app/tokens.css

EXPOSE 8000
CMD ["sh", "-c", "alembic upgrade head && uvicorn mathdesk.main:app --host 0.0.0.0 --port 8000"]
