# 테스트 운영(Phase A′) 이미지: 웹 정적 빌드를 API가 단일 오리진으로 서빙한다.
FROM node:24-alpine AS web
WORKDIR /web
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci
COPY apps/web/ ./
RUN npm run build

FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /usr/local/bin/uv

WORKDIR /app
COPY apps/api/pyproject.toml apps/api/uv.lock apps/api/alembic.ini ./
COPY apps/api/src ./src
COPY apps/api/migrations ./migrations
RUN uv sync --frozen --no-dev
COPY --from=web /web/dist ./web

ENV PATH="/app/.venv/bin:$PATH" \
    MATHDESK_WEB_DIST=/app/web

EXPOSE 8000
CMD ["sh", "-c", "alembic upgrade head && uvicorn mathdesk.main:app --host 0.0.0.0 --port 8000"]
