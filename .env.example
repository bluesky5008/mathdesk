# 테스트 운영(compose.testops.yaml)용 설정. 실제 값은 .env에 두며 git에 올리지 않는다.
POSTGRES_PASSWORD=
MATHDESK_INITIAL_ADMIN_ID=director
MATHDESK_INITIAL_ADMIN_PASSWORD=

# 선택: 기본값을 바꿀 때만 지정
