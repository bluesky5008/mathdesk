# MATHDESK_LOGIN_LOCKOUT_SECONDS=180
# MATHDESK_RECHECK_THRESHOLD_GRADE=B

# 선택: 문자·알림톡 실발송(ops/messaging-setup.md). 비워 두면 테스트 모드
