# 테스트 운영(compose.testops.yaml)·운영(compose.prod.yaml) 설정. 실제 값은 .env에 두며 git에 올리지 않는다.
POSTGRES_PASSWORD=
MATHDESK_INITIAL_ADMIN_ID=director
MATHDESK_INITIAL_ADMIN_PASSWORD=

# 선택: 기본값을 바꿀 때만 지정
# MATHDESK_LOGIN_MAX_ATTEMPTS=10
# MATHDESK_LOGIN_LOCKOUT_SECONDS=180
# MATHDESK_RECHECK_THRESHOLD_GRADE=B

# 선택: 문자·알림톡 실발송(ops/messaging-setup.md). 비워 두면 테스트 모드
# MATHDESK_MESSAGING_MODE=live
# ALIGO_API_KEY=
# ALIGO_USER_ID=
# ALIGO_SENDER=01012345678
# ALIGO_SENDER_KEY=          # 알림톡 발신프로필 키(알림톡을 쓸 때만)

# ── 운영 서버(compose.prod.yaml)에서만 ─────────────────────────────
# MATHDESK_IMAGE_TAG=2026.10.17        # ops/deploy.sh가 배포 때마다 바꾼다. 첫 설치 때만 손으로
# CLOUDFLARE_TUNNEL_TOKEN=             # 클라이언트 Cloudflare 계정의 원격 관리형 터널 토큰
# 시험지 분석 LLM(비워 두면 test 구현체). 공급자: anthropic | openai_compat
# MATHDESK_LLM_PROVIDER=anthropic
# MATHDESK_LLM_MODEL=
# MATHDESK_LLM_API_KEY=
# MATHDESK_LLM_BASE_URL=               # openai_compat일 때만
